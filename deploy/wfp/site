#!/bin/bash
# Add or remove one site of the reference deployment (issue #35, slice 3).
#   CLOUDFLARE_API_TOKEN=... deploy/wfp/site add <name>
#   CLOUDFLARE_API_TOKEN=... deploy/wfp/site remove <name>
#   CLOUDFLARE_API_TOKEN=... deploy/wfp/site update <name>    (or: update --all)
#     (DROP_SETTINGS=<names> drops recorded per-site settings on purpose, #558)
#   CLOUDFLARE_API_TOKEN=... deploy/wfp/site restore <name> [snapshot key]   (#515: after a failed data restore)
#   CLOUDFLARE_API_TOKEN=... deploy/wfp/site schedule <name>   (#533: the daily snapshot cron of an existing site)
#   CLOUDFLARE_API_TOKEN=... deploy/wfp/site list
#   CLOUDFLARE_API_TOKEN=... SQLITE=<file>|DUMP=<file> [CONTENT=<wp-content.tar.gz>] deploy/wfp/site import <name>
# The shared pieces must exist (up.sh). add builds nothing: b-dosql must be
# built (up.sh, or BUILD=1 here). Use the same WFP_STATE as up.sh.
#
# add touches only names of its own site: it refuses when ANY part of the
# site exists already (its workspace, dispatcher, user Worker, map entry or
# bucket), so it can never overwrite one. Then site.sh up, then every part is
# checked present. remove refuses a site with no part at all; then site.sh down
# (each removal checked as it goes), then every part is checked absent and the
# workspace gone. Neither reads or writes another site's resources:
# isolation.sh proves it live with snapshots of the other sites.
set -euo pipefail
. "$(dirname "$0")/lib.sh"
need_account
: "${CLOUDFLARE_API_TOKEN:?set CLOUDFLARE_API_TOKEN}"
cmd=${1:-}; s=${2:-}
if [ "$cmd" = list ]; then list_sites; exit 0; fi
case "$cmd" in add|remove|update|import|restore|schedule) ;; *) echo "usage: site add|remove|update|import|restore|schedule <name> | site update --all | site list" >&2; exit 2 ;; esac
tfr shared init -input=false >/dev/null
KV_ID=$(tfr shared output -raw kv_namespace_id 2>/dev/null) || { echo "no shared pieces (run up.sh first)" >&2; exit 2; }
[ -n "$KV_ID" ] || { echo "no shared pieces (run up.sh first)" >&2; exit 2; }
SUB=$(subdomain)
has_ws() { list_sites | grep -qx "$1"; }
# Update one site: snapshot the data, rebuild from the current tree, re-upload
# the SAME script (same object, same data) when the build id or the config
# hash differs, record both, and verify the new build is live and the site
# answers. The config hash is the rendered user config plus the sorted secret
# key names (#421). A missing hash uploads once. FORCE_UPLOAD=1 uploads even
# when both match. On failure, roll back: restore the data from the snapshot
# and re-deploy the exact code that was live (the build artifact saved before
# the rebuild, only when it IS this site's live build, #464); the rollback drops
# writes made since the snapshot. Every step that can fail stops the update
# (this runs where set -e is off: update --all calls it inside an if).
# #515: if the rollback's data restore FAILS, the database is partial. The update then marks the
# site map entry (data_hold = the snapshot key), prints the recovery, and exits 3, not 1, so it
# cannot be read as an ordinary failed update. While the mark is set, an update refuses (exit 2)
# before it changes anything, so a partial database is never snapshotted as the new truth.
# Exit codes: 0 updated or nothing to do, 1 failed (rolled back), 2 refused, 3 DATA RESTORE FAILED.
# The work dir of one update (the recorded inputs, #379), removed however update_one ends.
update_one() {
  local WDIR rc=0; WDIR=$(mktemp -d); chmod 700 "$WDIR"
  update_one_inner "$@" || rc=$?
  rm -rf "$WDIR"
  return "$rc"
}
update_one_inner() {
  local s=$1
  valid_site "$s" || { echo "bad site name: $s" >&2; return 2; }
  has_ws "$s" || { echo "no site $s (run site add first)" >&2; return 2; }
  tfr site init -input=false >/dev/null; tfr site workspace select "$s" >/dev/null
  # The hostname, Custom Domain and zone the workspace records win over the
  # computed ones (lib.sh site_vars): recomputing them would re-key the entry
  # or replace the Custom Domain, and take the site off its domain.
  site_vars "$s" "$SUB" "$KV_ID" || return 1
  local ORIGIN="https://$REC_HOST"
  echo "site $s: hostname $REC_HOST, custom domain $REC_CD (recorded or computed by lib.sh site_vars)"
  local TOK bucket EP rollback new ok=1 snap_key="" live_hash=""
  TOK=$(tfr site output -raw spike_token); bucket=$(media_bucket "$s"); EP=$(tfr site output -raw r2_endpoint)
  rollback=$(entry_build "$s")
  live_hash=$(entry_config_hash "$s")
  echo "site $s: the live build is ${rollback:-unknown}"
  if [ -n "$live_hash" ]; then echo "site $s: the recorded config hash is $live_hash"; else echo "site $s: no config hash is recorded"; fi
  # #515: a held site (its last rollback could not restore the data) is not updated.
  local hold; hold=$(entry_data_hold "$s")
  if [ -n "$hold" ]; then
    echo "site $s: update REFUSED: a rollback's data restore failed, so the database may be PARTIAL (#515). The hold names the snapshot $bucket/_snapshots/$hold. Nothing was changed." >&2
    print_restore_help "$s" "$ORIGIN" "$bucket" "$hold"
    return 2
  fi
  # The site's recorded build inputs (#379): reused when this run passes none, compared when it does.
  # local -x keeps a recorded value inside this one update (update --all runs many).
  local -x PLUGINS="${PLUGINS:-}" THEMES="${THEMES:-}" SUITE="${SUITE:-}" THEME_SUITE="${THEME_SUITE:-}" IMPORT_THEMES="${IMPORT_THEMES:-}" IMPORT_PLUGINS="${IMPORT_PLUGINS:-}" IMPORT_MU_PLUGINS="${IMPORT_MU_PLUGINS:-}" WOO_ACTIVE="${WOO_ACTIVE:-}" IMPORT_CONTENT="${IMPORT_CONTENT:-}"
  local REC_TREE=""
  echo "site $s: the recorded build inputs"
  use_recorded_inputs "$bucket" "$WDIR" || { echo "site $s: update refused; nothing was changed" >&2; return 2; }
  # The site's recorded settings (#558): kept unless this run sets one or DROP_SETTINGS names it.
  # local -x keeps them inside this one update (update --all runs many).
  local -x PHP_INI="${PHP_INI:-}" LAZY_CACHE_MB="${LAZY_CACHE_MB:-}" LAZY_ARENA="${LAZY_ARENA:-}" LAZY_ARENA_MB="${LAZY_ARENA_MB:-}" PHP_RECYCLE="${PHP_RECYCLE:-}" CRON_INTERVAL_MS="${CRON_INTERVAL_MS:-}" TURNSTILE_SITEKEY="${TURNSTILE_SITEKEY:-}" TURNSTILE_WOO="${TURNSTILE_WOO:-}" TURNSTILE_LOGIN="${TURNSTILE_LOGIN:-}" TURNSTILE_COMMENTS="${TURNSTILE_COMMENTS:-}" MAIL_FROM="${MAIL_FROM:-}" MAIL_FROM_NAME="${MAIL_FROM_NAME:-}" PHP_LOCATION="${PHP_LOCATION:-}" WP_VECTORIZE_SEARCH="${WP_VECTORIZE_SEARCH:-}" OPCACHE_SPLIT="${OPCACHE_SPLIT:-}" OPCACHE_REMOTE="${OPCACHE_REMOTE:-}" SITE_REMOTE="${SITE_REMOTE:-}" REMOTE_FETCH_CAP="${REMOTE_FETCH_CAP:-}" REMOTE_HOLD_KIB="${REMOTE_HOLD_KIB:-}" SITE_FETCH_CAP="${SITE_FETCH_CAP:-}" SITE_HOLD_KIB="${SITE_HOLD_KIB:-}" SITE_RETRY_MS="${SITE_RETRY_MS:-}"
  local SETTINGS_RECORDED=0
  echo "site $s: the recorded settings"
  keep_settings "$bucket" "$WDIR" || { echo "site $s: update refused; nothing was changed" >&2; return 2; }
  # Refuse before any change a build the live site cannot run (#377, lib.sh update_inputs_check).
  local woo code; woo=$(woo_active_for_build) || return 2
  code=$(store_api_code "$ORIGIN")
  echo "site $s: the live Store API answers $code; this build primes WooCommerce: $woo; content inputs: $(content_inputs_set)"
  update_inputs_check "${rollback:-}" "$code" "$woo" "$(content_inputs_set)" || { echo "site $s: update refused; nothing was changed" >&2; return 2; }
  tree_clean_check || { echo "site $s: update refused; nothing was changed" >&2; return 2; }
  [ "${COUNT_ROWS:-0}" = 1 ] && echo "site $s: rows before: $(row_count "$ORIGIN" "$TOK")"
  if [ "${NO_SNAPSHOT:-0}" != 1 ]; then
    snap_key="$s/${rollback:-unknown}-$(date -u +%Y%m%dT%H%M%SZ).ndjson"
    echo "site $s: snapshot the data to $bucket/_snapshots/$snap_key"
    WFP_S3_ENDPOINT="$EP" NAMESPACE=$NAMESPACE KV_ID=$KV_ID SUB=$SUB \
      python3 -I "${WFP_SNAPSHOT:-$WFP/snapshot.py}" dbsnapshot "$ORIGIN" "$TOK" "$bucket" "$snap_key" \
      || { echo "site $s: the snapshot did not store; aborting (a rollback would have no way back)" >&2; return 1; }
  fi
  # Save the live code before rebuilding, so a rollback re-uploads the code
  # that was live (issue #137): a git-worktree rebuild of the old sha is
  # fragile (a fresh worktree has no node_modules or vendor, and it would carry
  # the dev wrangler.toml, not the wfp user config). The site's own artifact in
  # its bucket comes first (#466): build/, vendor/ and the Worker sources of
  # its live build. Else build/, only when its build id is this site's live one:
  # build/ is what this clone built LAST, which can be another site's (#464).
  local SAVED="" live_build="" why=""
  SAVED=$(mktemp -d)
  if why=$(save_rollback_tree "$bucket" "${rollback:-}" "$SAVED"); then
    live_build=$why
    echo "site $s: saved the live build $live_build for rollback"
  else
    rm -rf "$SAVED"; SAVED=""
    echo "site $s: NO code rollback artifact: $why. If this update fails, the data is restored but the code is not." >&2
  fi
  echo "site $s: rebuild from the current tree"
  # Stop on a failed build, before any upload (#464): set -e is off here.
  build_dosql || { echo "site $s: the build failed; nothing was uploaded" >&2; [ -n "$SAVED" ] && rm -rf "$SAVED"; return 1; }
  new=$(sed -n 's/export default "\(.*\)";/\1/p' "$APP/build/build-id.js" 2>/dev/null || true)
  [ -n "$new" ] || { echo "site $s: the build left no build id; nothing was uploaded" >&2; [ -n "$SAVED" ] && rm -rf "$SAVED"; return 1; }
  # Render before the decision (#421). The hash is this file plus the sorted
  # names of the keys in the secrets JSON. Values stay in the file, mode 600,
  # and are removed on every return from this point.
  # #533: a site recorded before the scheduled snapshot has no snapshot_token in its workspace. The
  # workspace is applied once, with the values the entry records (build, config hash; no hold: a held
  # site was refused above), so the upload below carries SNAPSHOT_TOKEN. It adds the token and
  # changes nothing else.
  if ! tfr site output -raw snapshot_token >/dev/null 2>&1; then
    echo "site $s: the workspace has no snapshot token yet (#533): apply it with the recorded build and config hash"
    tfr site apply -input=false -auto-approve "${REC_VARS[@]}" -var "build=${rollback:-unknown}" -var "config_hash=$live_hash" >/dev/null \
      && tfr site output -raw snapshot_token >/dev/null 2>&1 \
      || { echo "site $s: the snapshot token could not be made; nothing was uploaded" >&2; [ -n "$SAVED" ] && rm -rf "$SAVED"; return 1; }
  fi
  local CONF="$APP/wrangler.deploy.wfp-$s.toml" W new_hash="" reasons=""
  W=$(mktemp -d); chmod 700 "$W"
  render_user "$s" "$ORIGIN" > "$CONF" || { echo "site $s: the user config did not render; nothing was uploaded" >&2; rm -rf "$W"; [ -n "$SAVED" ] && rm -rf "$SAVED"; return 1; }
  tfr site output -json | site_secrets_json "$W/sec.json" || { echo "site $s: the site secrets did not read; nothing was uploaded" >&2; rm -rf "$W"; [ -n "$SAVED" ] && rm -rf "$SAVED"; return 1; }
  new_hash=$(config_hash "$CONF" "$W/sec.json") || { rm -rf "$W"; [ -n "$SAVED" ] && rm -rf "$SAVED"; return 1; }
  reasons=$(update_upload_reasons "$new" "${rollback:-}" "$new_hash" "$live_hash")
  if [ -z "$reasons" ]; then
    echo "site $s: already at build $new; nothing to do"
    # Nothing is uploaded, so the live config is this run's: a site with no record gets one (#558).
    [ "$SETTINGS_RECORDED" = 1 ] || record_settings "$bucket" "$WDIR" || echo "site $s: its settings were NOT recorded (#558)" >&2
    rm -rf "$W"; [ -n "$SAVED" ] && rm -rf "$SAVED"; return 0
  fi
  # #558: never upload a config that drops a setting or a secret the LIVE script has, unless
  # DROP_SETTINGS names it. The guard for a site with no record yet, and for any miss of the merge.
  settings_dropcheck "$(user_script "$s")" "$CONF" "$W/sec.json" "$W" || { echo "site $s: update refused; nothing was uploaded" >&2; rm -rf "$W"; [ -n "$SAVED" ] && rm -rf "$SAVED"; return 2; }
  echo "site $s: upload build $new (was ${rollback:-unknown}); reason: $reasons"
  # WP_VECTORIZE_SEARCH (#330): the binding needs its index to exist at deploy (lib.sh).
  if search_on; then ensure_search_index "$s" || { rm -rf "$W"; [ -n "$SAVED" ] && rm -rf "$SAVED"; return 1; }; fi
  # #569: a remote build is never uploaded without its ASSETS binding and /_pf/ first.
  remote_assets_check "$CONF" "$APP" || { echo "site $s: update refused; nothing was uploaded" >&2; rm -rf "$W"; [ -n "$SAVED" ] && rm -rf "$SAVED"; return 2; }
  bundle_size_check || { rm -rf "$W"; [ -n "$SAVED" ] && rm -rf "$SAVED"; return 1; }
  # A failed upload changed nothing live; the log is read BEFORE the work dir goes.
  (cd "$APP" && "$WR" deploy --config "$CONF" --dispatch-namespace "$NAMESPACE" --secrets-file "$W/sec.json") > "$W/up.log" 2>&1 || { echo "site $s: upload failed:" >&2; tail -20 "$W/up.log" >&2; rm -rf "$W"; [ -n "$SAVED" ] && rm -rf "$SAVED"; return 1; }
  rm -rf "$W"
  # OBSERVABILITY=1 logs events only, but each event still carries the URL; a store's query strings
  # hold order keys and logins. wrangler cannot set the redaction, so it is set here, then read back.
  if [ "${OBSERVABILITY:-0}" = 1 ]; then python3 -I "$WFP/obs_settings.py" redact "$NAMESPACE" "site-$s" || { echo "site $s: UPLOADED, but the query-string redaction did NOT apply: turn the logs off (run the update again with no OBSERVABILITY)" >&2; ok=0; }; fi
  tfr site apply -input=false -auto-approve "${REC_VARS[@]}" -var "build=$new" -var "config_hash=$new_hash" >/dev/null || { echo "site $s: the site map entry did not record build $new" >&2; ok=0; }
  echo "site $s: verify the new build is live"
  wait_build "$ORIGIN" "$TOK" "$new" || ok=0
  [ "$ok" = 1 ] && { [ "$(curl -s -o /dev/null -w '%{http_code}' -m 60 "$ORIGIN/?nocache=$RANDOM")" = 200 ] || { echo "site $s: the site did not answer 200 after the update" >&2; ok=0; }; }
  # A test hook (issue #35 slice 5): force the verify to fail, to exercise the
  # rollback path against an otherwise-good new build. Off unless FORCE_FAIL=verify.
  [ "${FORCE_FAIL:-}" = verify ] && { echo "site $s: FORCE_FAIL=verify, forcing a verify failure to exercise the rollback" >&2; ok=0; }
  if [ "$ok" = 1 ]; then
    [ -n "$SAVED" ] && rm -rf "$SAVED"
    [ "${COUNT_ROWS:-0}" = 1 ] && echo "site $s: rows after (updated): $(row_count "$ORIGIN" "$TOK")"
    local rec_rc=0
    echo "site $s: updated $rollback -> $new"
    record_build_inputs "$bucket" "$new" "$WDIR" || { echo "site $s: UPDATED, but its build inputs were NOT recorded (#379): run the update again with the same inputs" >&2; rec_rc=1; }
    record_settings "$bucket" "$WDIR" || { echo "site $s: UPDATED, but its settings were NOT recorded (#558): run the update again with the same settings" >&2; rec_rc=1; }
    # The rollback artifact of the build now live (#466), also when the record failed: the code is
    # live either way. Keeps this one and $rollback.
    write_rollback_artifact "$bucket" "$new" "${rollback:-}"
    return "$rec_rc"
  fi
  echo "site $s: ROLLING BACK to $rollback. NOTE: a rollback drops any write made between the snapshot and now." >&2
  local restore_failed=0
  if [ -n "$snap_key" ]; then
    WFP_S3_ENDPOINT="$EP" python3 -I "${WFP_SNAPSHOT:-$WFP/snapshot.py}" dbrestore "$ORIGIN" "$TOK" "$bucket" "$snap_key" \
      || { restore_failed=1; echo "site $s: the data restore FAILED; the snapshot is $bucket/_snapshots/$snap_key" >&2; }
  fi
  # The saved build must still be this site's live one (#464): never re-deploy another build.
  if [ -n "$SAVED" ] && ! rollback_build_ok "$live_build" "${rollback:-}"; then
    echo "site $s: the saved build ${live_build:-unknown} is not this site's live build ${rollback:-unknown}; it is NOT re-deployed." >&2
    rm -rf "$SAVED"; SAVED=""
  fi
  if [ -n "$SAVED" ]; then
    echo "site $s: re-deploy the saved build $live_build"
    # From the saved tree: its own build/, vendor/ and sources (#466), this run's config, and
    # this tree's node_modules (pinned by the lock file). $APP/build is left as it is. The tree is
    # moved into a mirror of the repo layout first, so the bundle is byte-equal to the original
    # deploy's (#507, lib.sh rollback_deploy_dir).
    local RBI="" RBROOT="" RBAPP="" RBWR=$WR
    if RBI=$(rollback_deploy_dir "$SAVED"); then
      IFS=$'\t' read -r RBROOT RBAPP RBWR <<< "$RBI"
      rm -rf "$SAVED"; SAVED=$RBAPP
    else
      echo "site $s: the rollback tree could not be placed in a mirror of the repo; it deploys from $SAVED (the bundle may differ in module path strings only)" >&2
      [ -e "$SAVED/node_modules" ] || ln -s "$APP/node_modules" "$SAVED/node_modules"
    fi
    cp "$CONF" "$SAVED/wrangler.rollback.toml"
    local W2; W2=$(mktemp -d)
    # #569: the rollback tree is a build too: a remote one needs its assets in this config.
    if ! remote_assets_check "$SAVED/wrangler.rollback.toml" "$SAVED"; then
      echo "site $s: the rollback was REFUSED: its build and this config do not fit (remote_assets_check above); deploy the old build by hand" >&2
    elif tfr site output -json | site_secrets_json "$W2/sec.json" && (cd "$SAVED" && "$RBWR" deploy --config "$SAVED/wrangler.rollback.toml" --dispatch-namespace "$NAMESPACE" --secrets-file "$W2/sec.json") > "$W2/rb.log" 2>&1; then
      echo "site $s: re-deployed ${live_build:-unknown}"
      tfr site apply -input=false -auto-approve "${REC_VARS[@]}" -var "build=$live_build" -var "config_hash=$live_hash" >/dev/null || echo "site $s: the site map entry did not record the rollback build $live_build" >&2
      wait_build "$ORIGIN" "$TOK" "$live_build" || echo "site $s: /_build did not return to $live_build after the rollback re-deploy" >&2
    else
      echo "site $s: the rollback re-deploy FAILED; the old code is NOT live. Deploy $live_build by hand. Reason:" >&2
      tail -20 "$W2/rb.log" 2>/dev/null >&2
    fi
    rm -rf "$W2"
    [ -n "$RBROOT" ] && rm -rf "$RBROOT"
  else
    echo "site $s: no saved build artifact of this site's live build; the old code is NOT re-deployed. Deploy ${rollback:-the old build} by hand. The data was restored from the snapshot." >&2
  fi
  [ -n "$SAVED" ] && rm -rf "$SAVED"
  [ "${COUNT_ROWS:-0}" = 1 ] && echo "site $s: rows after (rolled back): $(row_count "$ORIGIN" "$TOK")"
  if [ "$restore_failed" = 1 ]; then
    # #515: the database holds only the parts before the failed one. Hold the site.
    echo "site $s: DATA RESTORE FAILED: the database is PARTIAL. The site map entry is marked, and the next site update REFUSES until the data is restored." >&2
    if tfr site apply -input=false -auto-approve "${REC_VARS[@]}" -var "build=$(entry_build "$s")" -var "config_hash=$(entry_config_hash "$s")" -var "data_hold=$snap_key" >/dev/null \
      && [ "$(entry_data_hold "$s")" = "$snap_key" ]; then
      echo "site $s: the hold is recorded (data_hold=$snap_key, read back)" >&2
    else
      echo "site $s: the hold could NOT be recorded in the site map entry: do NOT run site update on $s before the restore" >&2
    fi
    print_restore_help "$s" "$ORIGIN" "$bucket" "$snap_key"
    return 3
  fi
  return 1
}

# Restore a held site's data from its snapshot, then clear the hold (#515). The key defaults to
# the one the hold records. Everything comes from the site's workspace (its origin, SPIKE_TOKEN,
# bucket); nothing secret is printed. On success, the hold is cleared with the build and config
# hash the entry records, and read back. Exit 0 restored and cleared, 1 failed, 2 refused.
restore_one() {
  local s=$1 key=${2:-}
  valid_site "$s" || { echo "bad site name: $s" >&2; return 2; }
  has_ws "$s" || { echo "no site $s" >&2; return 2; }
  tfr site init -input=false >/dev/null; tfr site workspace select "$s" >/dev/null
  site_vars "$s" "$SUB" "$KV_ID" || return 1
  local ORIGIN="https://$REC_HOST" TOK bucket EP hold
  TOK=$(tfr site output -raw spike_token); bucket=$(media_bucket "$s"); EP=$(tfr site output -raw r2_endpoint)
  hold=$(entry_data_hold "$s")
  key=${key:-$hold}
  key=${key#_snapshots/}
  [ -n "$key" ] || { echo "site $s: no hold is recorded; pass the snapshot key: site restore $s <key under _snapshots/>" >&2; return 2; }
  case "$key" in *[!A-Za-z0-9._/-]*|*..*) echo "site $s: $key is not a snapshot key" >&2; return 2 ;; esac
  echo "site $s: restore the data from $bucket/_snapshots/$key (replaces the whole database)"
  WFP_S3_ENDPOINT="$EP" python3 -I "${WFP_SNAPSHOT:-$WFP/snapshot.py}" dbrestore "$ORIGIN" "$TOK" "$bucket" "$key" || {
    echo "site $s: the restore FAILED; the hold stays${hold:+ (data_hold=$hold)}" >&2; return 1; }
  echo "site $s: rows now: $(row_count "$ORIGIN" "$TOK")"
  if [ -n "$hold" ]; then
    tfr site apply -input=false -auto-approve "${REC_VARS[@]}" -var "build=$(entry_build "$s")" -var "config_hash=$(entry_config_hash "$s")" -var "data_hold=" >/dev/null \
      && [ -z "$(entry_data_hold "$s")" ] || { echo "site $s: RESTORED, but the hold could not be cleared (it still reads $(entry_data_hold "$s"))" >&2; return 1; }
    echo "site $s: the hold is cleared (read back)"
  fi
  echo "site restore $s: done"
}

# The daily snapshot cron of an EXISTING site (#533, design A'): re-deploy its dispatcher copy
# wp-<name> with the cron and the site's SNAPSHOT_TOKEN (lib.sh render_site_dispatcher). A new site
# gets both from site add. Order: the user Worker must hold SNAPSHOT_TOKEN first (site update
# uploads it), or every cron run is a 403; this refuses until it does. SNAPSHOT_CRON=off removes the
# cron. A phase B site (a Custom Domain on the shared wp-dispatch) gets its CRON-ONLY copy: the same
# script with no route and no workers.dev, read back unreachable (lib.sh cron_copy_check). The cron
# can take up to 15 minutes to arm. Exit 0 deployed and read back, 1 failed, 2 refused.
schedule_one() {
  local s=$1
  valid_site "$s" || { echo "bad site name: $s" >&2; return 2; }
  has_ws "$s" || { echo "no site $s" >&2; return 2; }
  tfr site init -input=false >/dev/null; tfr site workspace select "$s" >/dev/null
  site_vars "$s" "$SUB" "$KV_ID" || return 1
  local D U names want got W
  D=$(dispatcher_name "$s"); U=$(user_script "$s")
  tfr site output -raw snapshot_token >/dev/null 2>&1 || { echo "site $s: refused: its workspace has no snapshot token yet; run site update $s first (#533)" >&2; return 2; }
  names=$(ns_secret_names "$U") || { echo "site $s: refused: the secret names of $U cannot be read" >&2; return 2; }
  printf '%s\n' "$names" | grep -qx SNAPSHOT_TOKEN || { echo "site $s: refused: $U does not hold SNAPSHOT_TOKEN yet, so every cron run would be a 403; run site update $s first (#533)" >&2; return 2; }
  want=$(snapshot_cron) || return 2
  W=$(mktemp -d); chmod 700 "$W"; mkdir -p "$GEN"
  local mode=""; [ "$REC_CD" = true ] && mode=cron-only
  render_site_dispatcher "$s" "$KV_ID" ${mode:+"$mode"} > "$GEN/$D.toml" || { rm -rf "$W"; return 2; }
  tfr site output -json | dispatcher_secrets_json "$W/sec.json" || { rm -rf "$W"; return 1; }
  echo "site $s: deploy $D with the snapshot cron [${want:-none}] (#533)"
  wrangler_deploy "$GEN" "$W/disp.log" --config "$D.toml" --secrets-file "$W/sec.json" || { echo "site $s: the dispatcher deploy failed:" >&2; tail -20 "$W/disp.log" >&2; rm -rf "$W"; return 1; }
  rm -rf "$W"
  got=$(api GET "/workers/scripts/$D/schedules" | sed '$d' | python3 -I -c 'import json, sys
try:
    r = json.load(sys.stdin).get("result") or {}
except ValueError:
    sys.exit(1)
print(" ".join(sorted(x.get("cron", "") for x in r.get("schedules") or [])))') || { echo "site $s: DEPLOYED, but the schedules of $D cannot be read back" >&2; return 1; }
  [ "$got" = "$want" ] || { echo "site $s: DEPLOYED, but $D reads schedules [$got], not [$want]" >&2; return 1; }
  if [ "$mode" = cron-only ]; then cron_copy_check "$D" || { echo "site $s: DEPLOYED, but the cron-only copy $D is reachable: delete it (wr delete --name $D)" >&2; return 1; }; echo "site $s: $D is cron-only (phase B): workers.dev and previews off, no Custom Domain (read back)"; fi
  echo "site $s: $D schedules read back [$got]; the first run can come up to 15 minutes after a change"
  echo "site schedule $s: done"
}

# Import an existing WordPress site into one site (deploy/import.sh, issue #31,
# for deploy/wfp). The site must exist (site add). Everything the import needs
# comes from the site's own workspace: its origin, its SPIKE_TOKEN, its media
# bucket. With CONTENT, the uploads go into that bucket with a key that can
# reach only that bucket: a temporary R2 credential minted here from the deploy
# token (lib.sh r2_temp_mint, #273), so nothing is made in the account or the
# state. It expires after R2_TEMP_TTL (21600 s), and media.sh mints a fresh one
# on a refusal. The import replaces the site's whole database.
import_one() {
  local s=$1
  valid_site "$s" || { echo "bad site name '$s': lower case, digits, hyphens; 1 to 30; not a shared Worker name (probe, dispatch, cacheprobe, cacheprobe-direct, wfp-*), not auto" >&2; return 2; }
  [ -n "${SQLITE:-}${DUMP:-}" ] || { echo "site import needs SQLITE=<file> or DUMP=<mysqldump file>" >&2; return 2; }
  has_ws "$s" || { echo "no site $s (run site add first)" >&2; return 2; }
  tfr site init -input=false >/dev/null; tfr site workspace select "$s" >/dev/null
  # The hostname, Custom Domain and zone the workspace records (lib.sh site_vars):
  # the import's origin is the site's real one.
  site_vars "$s" "$SUB" "$KV_ID" || return 1
  local HOST=$REC_HOST
  local TOK; TOK=$(tfr site output -raw spike_token)
  local need_key=0
  if [ -n "${CONTENT:-}" ] && [ -z "${DRY_RUN:-}" ] && [ -z "${SKIP_MEDIA:-}" ]; then need_key=1; fi
  local cf="" ttl=${R2_TEMP_TTL:-21600} B=""
  if [ "$need_key" = 1 ]; then
    B=$(media_bucket "$s"); cf=$(mktemp); chmod 600 "$cf"
    # shellcheck disable=SC2064 # the path is fixed now: $cf is local and gone by EXIT
    trap "rm -f '$cf' '$cf.flock' '$cf.minted'" EXIT
    r2_temp_mint "$B" "$ttl" "$cf" || { rm -f "$cf"; trap - EXIT; echo "site $s: no temporary credential for $B; nothing was imported" >&2; return 1; }
  fi
  local rc=0
  URL="https://$HOST" SPIKE_TOKEN="$TOK" \
    MEDIA_BUCKET="$B" \
    R2_ENDPOINT="$([ "$need_key" = 1 ] && tfr site output -raw r2_endpoint)" \
    R2_CRED_FILE="$cf" R2_CRED_REFRESH="$([ "$need_key" = 1 ] && r2_temp_refresh_cmd "$B" "$ttl" "$cf")" \
    NAME="" "$ROOT/deploy/import.sh" || rc=$?
  if [ "$need_key" = 1 ]; then
    rm -f "$cf" "$cf.flock" "$cf.minted"; trap - EXIT
    echo "site $s: the temporary credential file is removed; the credential expires within $ttl s"
  fi
  [ "$rc" = 0 ] && echo "site import $s: done, https://$HOST"
  return "$rc"
}

if [ "$cmd" = import ]; then import_one "$s"; exit $?; fi
if [ "$cmd" = restore ]; then restore_one "$s" "${3:-}"; exit $?; fi
if [ "$cmd" = schedule ]; then schedule_one "$s"; exit $?; fi

if [ "$cmd" = update ]; then
  if [ "$s" = "--all" ]; then
    # shellcheck disable=SC2046
    update_all update_one $(list_sites); exit $?
  fi
  update_one "$s"; exit $?
fi
valid_site "$s" || { echo "bad site name '$s': lower case, digits, hyphens; 1 to 30; not a shared Worker name (probe, dispatch, cacheprobe, cacheprobe-direct, wfp-*), not auto" >&2; exit 2; }

if [ "$cmd" = add ]; then
  fp=$(site_footprint "$s")
  if has_ws "$s" || ! footprint_absent "$fp"; then
    echo "site $s already exists, in part or in full; nothing was changed:" >&2
    has_ws "$s" && echo "  workspace $s" >&2
    printf '%s\n' "$fp" | sed 's/^/  /' >&2
    exit 2
  fi
  [ "${BUILD:-0}" = 0 ] || build_dosql
  [ -f "$APP/build/opcache.log" ] || { echo "b-dosql is not built (run up.sh, or BUILD=1)" >&2; exit 2; }
  "$WFP/site.sh" up "$s"
  fp=$(site_footprint "$s")
  footprint_present "$fp" || { echo "site $s: not every part is there after the add:" >&2; printf '%s\n' "$fp" | sed 's/^/  /' >&2; exit 1; }
  # Its scripts bind only its own resources (bindings.py, #35 slice 4).
  NAMESPACE=$NAMESPACE KV_ID=$KV_ID python3 -I "$WFP/bindings.py" "$s"
  # The rollback artifact of the build this add deployed (#466): the first update can roll back to it.
  write_rollback_artifact "$(media_bucket "$s")" "$(sed -n 's/export default "\(.*\)";/\1/p' "$APP/build/build-id.js")"
  # The settings this add rendered (#558), so the first update keeps them.
  W=$(mktemp -d); chmod 700 "$W"
  record_settings "$(media_bucket "$s")" "$W" || echo "site $s: ADDED, but its settings were NOT recorded (#558): the first update must pass them" >&2
  rm -rf "$W"
  # A build made by this run is recorded (#379); with no BUILD=1 the build came from elsewhere.
  if [ "${BUILD:-0}" != 0 ]; then
    W=$(mktemp -d); chmod 700 "$W"
    record_build_inputs "$(media_bucket "$s")" "$(sed -n 's/export default "\(.*\)";/\1/p' "$APP/build/build-id.js")" "$W" || echo "site $s: ADDED, but its build inputs were NOT recorded (#379): the first update must pass them" >&2
    rm -rf "$W"
  fi
  echo "site add $s: done, https://$(site_host "$s" "$SUB")"
else
  # An existing site's recorded hostname and domain decide what its parts are
  # (lib.sh site_vars), so the footprint checks the right entry and domain.
  if has_ws "$s"; then
    tfr site init -input=false >/dev/null; tfr site workspace select "$s" >/dev/null
    site_vars "$s" "$SUB" "$KV_ID" || exit 1
    tfr site workspace select default >/dev/null
  fi
  fp=$(site_footprint "$s")
  if ! has_ws "$s" && footprint_absent "$fp"; then
    echo "no site $s: nothing to remove" >&2
    exit 2
  fi
  # A site the provisioning core made (cli.mjs, the provisioning Worker) has no workspace here
  # and parts this package does not make; refuse it whole, before any change (#294).
  if ! has_ws "$s"; then
    by=$(entry_by_core "$s")
    if [ "$by" = core ] || [ "$by" = unknown ]; then
      why="the provisioning core wrote its site map entry"; [ "$by" = unknown ] && why="who wrote its site map entry is unknown"
      echo "site $s was not made by deploy/wfp (no workspace; $why); nothing was changed." >&2
      echo "  deploy/wfp/site removes only a site it made. The parts found:" >&2
      printf '%s\n' "$fp" | sed 's/^/    /' >&2
      echo "  A core site can also have the KV namespace wp-wfp-$s-oc and the resources of its opt-in integrations (deploy/provision/wp-site-config.mjs)." >&2
      exit 2
    fi
  fi
  "$WFP/site.sh" down "$s"
  fp=$(site_footprint "$s")
  footprint_absent "$fp" || { echo "site $s: not every part is gone after the remove:" >&2; printf '%s\n' "$fp" | sed 's/^/  /' >&2; exit 1; }
  has_ws "$s" && { echo "site $s: its workspace is still there" >&2; exit 1; }
  echo "site remove $s: done, every part is gone"
fi
